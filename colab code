# outlier Fixing (IQR)

import pandas as pd
import numpy as np

def replace_outliers_with_median_by_cluster(data, cluster_col, numerical_cols):
    """
    Replaces outliers in numerical columns with the median value within each cluster.

    Args:
        data (pd.DataFrame): The input DataFrame.
        cluster_col (str): The name of the column containing cluster assignments.
        numerical_cols (list): A list of numerical columns to check for outliers.
    """
    for cluster in data[cluster_col].unique():
        cluster_data = data[data[cluster_col] == cluster]
        for col in numerical_cols:
            # Calculate median for the cluster and column
            median_value = cluster_data[col].median()

            # Identify outliers using IQR method within the cluster
            Q1 = cluster_data[col].quantile(0.25)
            Q3 = cluster_data[col].quantile(0.75)
            IQR = Q3 - Q1
            lower_bound = Q1 - 1.5 * IQR
            upper_bound = Q3 + 1.5 * IQR
            outliers = cluster_data[(cluster_data[col] < lower_bound) | (cluster_data[col] > upper_bound)]

            # Replace outliers with median
            if not outliers.empty:  # Check if there are outliers to replace
                data.loc[(data[cluster_col] == cluster) & (data[col].isin(outliers[col])), col] = median_value

    print("Outliers replaced with median within each cluster.")

